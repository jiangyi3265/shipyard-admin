# Copy to .env.development. Values prefixed VITE_ are public browser configuration.
VITE_APP_TITLE=船厂工程管理后台
VITE_APP_ENV=development
VITE_APP_BASE_API=/dev-api
VITE_APP_BASE_PATH=/

# Dev server upstream/port use shell environment variables, not this file:
# SHIPYARD_API_TARGET=http://127.0.0.1:8083
# SHIPYARD_ADMIN_PORT=5180
